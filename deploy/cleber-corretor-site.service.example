[Unit]
Description=Cléber Corretor Site
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/cleber-corretor-site
Environment=PORT=8081
Environment=HOST=0.0.0.0
Environment=CC_SITE_ORIGIN=https://imoveis.codeflowsoluctions.com
Environment=CC_API_BASE=https://cadastro.codeflowsoluctions.com
Environment=CC_SITE_NAME=Cléber Corretor
ExecStart=/usr/bin/node /home/ubuntu/cleber-corretor-site/site-server.js
Restart=always
RestartSec=5
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
